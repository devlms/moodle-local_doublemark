{{!
    @template local_doublemark/compare

    The two independent marks side by side, with each marker's comment.

    Context variables required for this template:
    * cards - list of {title, marker, mark, comment, when}
    * gap, hasgap

    Example context (json):
    {
        "cards": [
            {"title": "First marker", "marker": "Priya Shah", "mark": "52", "comment": "The data plan has gaps.", "when": "3/11/26, 10:00"},
            {"title": "Second marker", "marker": "Tom Becker", "mark": "74", "comment": "", "when": "4/11/26, 16:20"}
        ],
        "gap": "22", "hasgap": true
    }
}}
<div class="local-doublemark-compare">
    {{#cards}}
    <section class="local-doublemark-card" aria-label="{{title}}">
        <p class="local-doublemark-card-title">{{title}}</p>
        <p class="local-doublemark-card-marker">{{marker}}</p>
        <p class="local-doublemark-card-mark">{{#mark}}{{mark}}{{/mark}}{{^mark}}<span class="local-doublemark-pending">{{#str}}notyet, local_doublemark{{/str}}</span>{{/mark}}</p>
        {{#comment}}<p class="local-doublemark-card-comment">{{comment}}</p>{{/comment}}
        {{#when}}<p class="local-doublemark-pending">{{when}}</p>{{/when}}
    </section>
    {{/cards}}
    {{#hasgap}}
    <p class="local-doublemark-compare-gap">{{#str}}gap, local_doublemark{{/str}} <strong>{{gap}}</strong></p>
    {{/hasgap}}
</div>
